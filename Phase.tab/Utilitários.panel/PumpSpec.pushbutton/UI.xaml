<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerar Descrição da Bomba - pyRevit" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Parâmetros Individuais Lidos -->
            <RowDefinition Height="Auto"/> <!-- 2. Pré-visualização e Edição -->
            <RowDefinition Height="Auto"/> <!-- 3. Quadro de Comando de Bomba (QCB) -->
            <RowDefinition Height="Auto"/> <!-- 4. Botão Salvar -->
        </Grid.RowDefinitions>

        <!-- 1. Parâmetros Extraídos da Bomba -->
        <GroupBox Grid.Row="0" Header=" 1. Valores Lidos da Bomba " FontWeight="Bold" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Fase:" VerticalAlignment="Center" FontWeight="Normal"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFase" VerticalContentAlignment="Center" IsReadOnly="True" Background="#E9ECEF" Padding="4,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tensão:" VerticalAlignment="Center" FontWeight="Normal"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTensao" VerticalContentAlignment="Center" IsReadOnly="True" Background="#E9ECEF" Padding="4,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Potência (HP):" VerticalAlignment="Center" FontWeight="Normal"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPotencia" VerticalContentAlignment="Center" IsReadOnly="True" Background="#E9ECEF" Padding="4,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vazão (m³/h):" VerticalAlignment="Center" FontWeight="Normal"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtVazao" VerticalContentAlignment="Center" IsReadOnly="True" Background="#E9ECEF" Padding="4,2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="MCA:" VerticalAlignment="Center" FontWeight="Normal"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtMCA" VerticalContentAlignment="Center" IsReadOnly="True" Background="#E9ECEF" Padding="4,2"/>
            </Grid>
        </GroupBox>

        <!-- 2. Texto Final Editável -->
        <GroupBox Grid.Row="1" Header=" 2. Descrição da Bomba (Editável antes de gravar) " FontWeight="Bold" Margin="0,0,0,12" Padding="10">
            <StackPanel>
                <TextBlock Text="Ajustar manualmente o texto antes de atualizar o parâmetro no Revit:" FontSize="11" FontWeight="Normal" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <TextBox x:Name="txtFinalDesc" Height="68" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6" FontWeight="Normal" FontSize="12"/>
            </StackPanel>
        </GroupBox>

        <!-- 3. Quadro de Comando da Bomba (QCB) -->
        <GroupBox Grid.Row="2" Header=" 3. Quadro de Comando (QCB) " FontWeight="Bold" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <CheckBox x:Name="chkNomearQCB" Content="Nomear QCB também" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,0,6" Checked="OnChkQcbChanged" Unchecked="OnChkQcbChanged"/>
                <StackPanel x:Name="pnlQCB" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock Text="Selecione o Quadro no projeto:" FontSize="11" FontWeight="Normal" Margin="0,4,0,4"/>
                    <ComboBox x:Name="cmbQuadros" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Descrição do QCB (Editável antes de gravar):" FontSize="11" FontWeight="Normal" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtQCBDesc" Height="34" VerticalContentAlignment="Center" Padding="6,2" FontSize="12" FontWeight="Normal"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 4. Botão Gravar -->
        <Button Grid.Row="3" x:Name="btnSalvar" Content="Gravar no Parâmetro" Height="36" Width="180" HorizontalAlignment="Right" Click="SalvarClick" Background="#28A745" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>